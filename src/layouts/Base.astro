---
import "../styles/global.css";
import { site } from "../config";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";

interface Props {
  title?: string;
  description: string;
  image?: string;
  imageAlt?: string;
  home?: boolean;
}

const {
  title,
  description,
  image = "/og.jpg",
  imageAlt = "Spark: Escape to Luma",
  home = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalUrl = new URL(path, site.url).toString();
const socialImageUrl = new URL(image, site.url).toString();
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  alternateName: site.brand,
  url: site.url,
};

const links = [
  { href: "/privacy", label: "Privacy" },
  { href: "/advertising", label: "Advertising" },
  { href: "/terms", label: "Terms" },
  { href: "/support", label: "Support" },
  { href: "/data", label: "Your Data" },
];

const sections = [
  { href: "/arcade", label: "Arcade" },
  { href: "/#features", label: "Features" },
  { href: "/#worlds", label: "Worlds" },
  { href: "/#gameplay", label: "Gameplay" },
  { href: "/story", label: "Story" },
  { href: "/origin", label: "Origin" },
  { href: "/news", label: "News" },
  { href: "/#faq", label: "FAQ" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050B15" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {home && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
  </head>
  <body class={home ? "is-home" : "is-doc"}>
    <a class="skip" href="#content">Skip to content</a>
    <header class="top">
      <a class="brand" href="/">
        <span class="mark">
          <img src="/mark.jpg" width="40" height="40" alt="" />
        </span>
        <span class="brand-text">
          SPARK
          <small>Escape to Luma</small>
        </span>
      </a>
      <input class="menu-check" id="menu" type="checkbox" />
      <label class="menu-button" for="menu">Menu</label>
      <nav class="primary" aria-label="Page">
        {sections.map((link) => (
          <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
      <a class="btn btn-small" href={site.appStoreUrl}>App Store</a>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="Store and policy">
        {
          links.map((link) => (
            <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
      <p class="fine">
        © {new Date().getFullYear()} {site.publisher}
        {" · "}
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {" · "}
        <button class="analytics-settings" type="button" data-analytics-settings>Analytics settings</button>
      </p>
    </footer>
    <AnalyticsConsent />
  </body>
</html>

<style>
  .analytics-settings {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--cyan);
    cursor: pointer;
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .analytics-settings:hover {
    color: var(--cyan-bright);
  }

  .analytics-settings:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }
</style>
