---
import { site } from "../config";
---

<aside class="analytics-consent" data-analytics-consent hidden aria-label="Analytics choice" role="dialog">
  <div>
    <p class="analytics-consent__title">Help improve Spark</p>
    <p class="analytics-consent__copy">
      With your permission, we use Google Analytics to understand site visits and Arcade play.
      <a href="/privacy">Privacy policy</a>
    </p>
  </div>
  <div class="analytics-consent__actions">
    <button class="analytics-consent__decline" type="button" data-analytics-decline>No thanks</button>
    <button class="analytics-consent__accept" type="button" data-analytics-accept>Allow analytics</button>
  </div>
</aside>

<style>
  .analytics-consent {
    position: fixed;
    z-index: 10;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: min(100% - 2rem, 44rem);
    margin-inline: auto;
    padding: 0.9rem 1rem 0.9rem 1.15rem;
    border: 1px solid rgba(0, 204, 255, 0.48);
    border-radius: 0.85rem;
    background: rgba(5, 16, 30, 0.96);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.42), inset 0 0 1.5rem rgba(0, 204, 255, 0.06);
    backdrop-filter: blur(18px);
  }

  .analytics-consent[hidden] {
    display: none;
  }

  .analytics-consent__title,
  .analytics-consent__copy {
    margin: 0;
  }

  .analytics-consent__title {
    color: var(--cream);
    font-size: 0.83rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .analytics-consent__copy {
    margin-top: 0.2rem;
    color: var(--cream-muted);
    font-size: 0.79rem;
  }

  .analytics-consent__actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.45rem;
  }

  .analytics-consent button {
    min-height: 2.35rem;
    border-radius: 0.45rem;
    padding: 0.5rem 0.7rem;
    cursor: pointer;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .analytics-consent__decline {
    border: 1px solid rgba(126, 240, 255, 0.42);
    background: transparent;
    color: var(--cream-muted);
  }

  .analytics-consent__accept {
    border: 1px solid #ffe17a;
    background: linear-gradient(180deg, #ffd54a, #ffae00);
    color: #1a1204;
  }

  .analytics-consent button:hover {
    filter: brightness(1.08);
  }

  .analytics-consent button:focus-visible {
    outline: 2px solid var(--cyan-bright);
    outline-offset: 3px;
  }

  @media (max-width: 620px) {
    .analytics-consent {
      align-items: stretch;
      flex-direction: column;
      gap: 0.8rem;
    }

    .analytics-consent__actions {
      justify-content: flex-end;
    }
  }
</style>

<script define:vars={{ measurementId: site.analyticsMeasurementId }}>
  const storageKey = "spark.analytics-consent.v1";
  const analyticsWindow = window;
  const banner = document.querySelector("[data-analytics-consent]");
  const accept = document.querySelector("[data-analytics-accept]");
  const decline = document.querySelector("[data-analytics-decline]");
  const settings = document.querySelector("[data-analytics-settings]");
  let googleTagLoaded = false;
  let consentState = readConsent();

  function readConsent() {
    try {
      const value = window.localStorage.getItem(storageKey);
      return value === "granted" || value === "denied" ? value : null;
    } catch {
      return null;
    }
  }

  function persistConsent(value) {
    try {
      window.localStorage.setItem(storageKey, value);
    } catch {
      // The banner remains functional when storage is unavailable.
    }
  }

  function loadGoogleAnalytics() {
    if (googleTagLoaded || !measurementId) return;
    googleTagLoaded = true;
    analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
    analyticsWindow.gtag = (...args) => analyticsWindow.dataLayer?.push(args);
    analyticsWindow.gtag("consent", "default", {
      analytics_storage: "denied",
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
    });
    analyticsWindow.gtag("consent", "update", { analytics_storage: "granted" });
    analyticsWindow.gtag("js", new Date());
    analyticsWindow.gtag("config", measurementId, {
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
    });

    const script = document.createElement("script");
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
    script.dataset.sparkAnalytics = "true";
    document.head.append(script);
    document.dispatchEvent(new CustomEvent("spark-analytics-ready"));
  }

  analyticsWindow.trackSparkEvent = (eventName, parameters = {}) => {
    if (consentState !== "granted") return;
    analyticsWindow.gtag?.("event", eventName, parameters);
  };

  function applyConsent(value) {
    consentState = value;
    persistConsent(value);
    if (banner) banner.hidden = true;
    if (value === "granted") loadGoogleAnalytics();
  }

  const savedConsent = consentState;
  if (savedConsent) {
    if (savedConsent === "granted") loadGoogleAnalytics();
  } else if (banner) {
    banner.hidden = false;
  }

  accept?.addEventListener("click", () => applyConsent("granted"));
  decline?.addEventListener("click", () => applyConsent("denied"));
  settings?.addEventListener("click", () => {
    if (banner) banner.hidden = false;
  });

  document.addEventListener("click", (event) => {
    const link = event.target?.closest?.('a[href*="apps.apple.com"]');
    if (!link) return;
    const placement = link.closest("header") ? "header" : link.closest("footer") ? "footer" : "page";
    analyticsWindow.trackSparkEvent?.("app_store_click", { placement });
  });
</script>
