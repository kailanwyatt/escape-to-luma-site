---
import { readFileSync } from "node:fs";
import Base from "../layouts/Base.astro";
import { site } from "../config";

const gameHtml = readFileSync(new URL("../../public/arcade/game/index.html", import.meta.url), "utf8");
const gameScript = gameHtml.match(/src="(\/arcade\/game\/_expo\/static\/js\/web\/[^"]+\.js)"/)?.[1];
if (!gameScript) {
  throw new Error("Arcade game bundle was not found in public/arcade/game/index.html");
}

const description =
  "Play Endless Voyage, the free browser Arcade mode for Spark: Escape to Luma. Read the moving opening, aim ahead, and launch to build a high score.";

const gameSchema = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: "Spark Arcade: Endless Voyage",
  description,
  url: `${site.url}/arcade`,
  image: `${site.url}/og-arcade.jpg`,
  genre: ["Arcade", "Precision"],
  playMode: "SinglePlayer",
  operatingSystem: "Web browser",
  applicationCategory: "GameApplication",
  isAccessibleForFree: true,
  inLanguage: "en",
  publisher: {
    "@type": "Organization",
    name: site.publisher,
  },
};
---

<Base
  title="Play Endless Voyage – Free Browser Game"
  description={description}
  image="/og-arcade.jpg"
  imageAlt="Spark races through a narrow opening between violet reaches toward a cyan portal in Endless Voyage."
>
  <script type="application/ld+json" set:html={JSON.stringify(gameSchema)} />
  <section class="arcade-game" id="game" aria-labelledby="game-title" data-arcade-game data-view="phone">
    <div class="arcade-game-heading">
      <div>
        <p class="kicker">Live signal // Endless Voyage</p>
        <h1 id="game-title"><span class="arcade-title-mode">Spark Arcade</span>: Endless Voyage</h1>
      </div>
      <div class="arcade-game-actions">
        <p>Drag to aim. Release to launch.</p>
        <button
          class="arcade-view-toggle"
          type="button"
          aria-label="Expand the game to wide view"
          aria-pressed="false"
          data-arcade-view-toggle
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M8 3H3v5M16 3h5v5M3 16v5h5M21 16v5h-5" />
          </svg>
          <span data-arcade-view-label>Wide view</span>
        </button>
        <a class="arcade-direct-launch" href="/arcade/game/" data-arcade-direct-launch>
          <span aria-hidden="true">▶</span>
          <span>Play direct</span>
        </a>
      </div>
    </div>
    <div class="arcade-cabinet">
      <div id="root" data-arcade-root></div>
    </div>
    <script is:inline defer src={gameScript} data-arcade-script></script>
  </section>

  <section class="arcade-rules" aria-labelledby="rules-title">
    <div>
      <p class="kicker">How to play</p>
      <h2 id="rules-title">One launch. One opening.</h2>
    </div>
    <ol>
      <li><strong>Aim ahead.</strong> The target keeps moving after Spark leaves.</li>
      <li><strong>Wait for the gap.</strong> Timing matters more than speed.</li>
      <li><strong>Build your run.</strong> Three hearts, one score, no campaign energy.</li>
    </ol>
  </section>
</Base>

<style>
  .arcade-game,
  .arcade-rules {
    width: min(100% - 2 * var(--gutter), 70rem);
    margin-inline: auto;
  }

  .arcade-game {
    padding: 2.4rem 0 4.5rem;
    transition: width 180ms ease;
  }

  .arcade-game[data-view="wide"] {
    width: calc(100% - 2 * var(--gutter));
  }

  .arcade-game-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 auto 1.1rem;
    max-width: 31rem;
  }

  .arcade-game-heading h1,
  .arcade-rules h2 {
    margin: 0.2rem 0 0;
  }

  .arcade-title-mode {
    white-space: nowrap;
  }

  .arcade-game-actions {
    display: grid;
    justify-items: end;
    gap: 0.55rem;
  }

  .arcade-game-actions > p {
    margin: 0;
    color: var(--cream-muted);
    font-size: 0.9rem;
    text-align: right;
  }

  .arcade-view-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.52rem;
    min-height: 2.45rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgba(0, 204, 255, 0.44);
    border-radius: 0.35rem;
    background: linear-gradient(135deg, rgba(18, 45, 65, 0.9), rgba(5, 14, 26, 0.94));
    box-shadow: inset 0 0 1rem rgba(0, 204, 255, 0.08);
    color: var(--cream-muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
  }

  .arcade-view-toggle svg {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--cyan-bright);
  }

  .arcade-view-toggle:hover,
  .arcade-view-toggle[aria-pressed="true"] {
    border-color: var(--cyan-bright);
    background: rgba(0, 204, 255, 0.18);
    color: var(--cream);
  }

  .arcade-view-toggle:focus-visible {
    outline: 2px solid var(--amber);
    outline-offset: 3px;
  }

  .arcade-direct-launch {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.8rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid #ffe17a;
    border-radius: 0.52rem;
    background: linear-gradient(180deg, #ffd54a, #ffae00);
    box-shadow: 0 0.7rem 1.5rem rgba(255, 174, 0, 0.2);
    color: #1a1204;
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .arcade-direct-launch:hover {
    color: #1a1204;
    filter: brightness(1.06);
  }

  .arcade-direct-launch:focus-visible {
    outline: 2px solid var(--cyan-bright);
    outline-offset: 3px;
  }

  .arcade-cabinet {
    width: min(100%, 31rem);
    aspect-ratio: 9 / 16;
    margin: 0 auto;
    overflow: hidden;
    overscroll-behavior: contain;
    border: 1px solid rgba(0, 204, 255, 0.62);
    border-radius: 1rem;
    background: #050b15;
    box-shadow: 0 0 0 1px rgba(255, 210, 74, 0.14), 0 1.2rem 3.8rem rgba(0, 204, 255, 0.16);
    contain: layout paint;
  }

  .arcade-cabinet #root {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  :global(.top) {
    backdrop-filter: none;
    background: rgba(5, 11, 21, 0.96);
  }

  .arcade-game[data-view="wide"] .arcade-game-heading {
    max-width: none;
  }

  .arcade-game[data-view="wide"] .arcade-cabinet {
    width: 100%;
    height: min(78svh, 54rem);
    aspect-ratio: auto;
    max-width: none;
  }

  .arcade-rules {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 3rem;
    padding: 3.6rem 0 5rem;
    border-top: 1px solid rgba(0, 204, 255, 0.16);
  }

  .arcade-rules ol {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding-left: 1.4rem;
  }

  .arcade-rules li {
    padding-left: 0.35rem;
    color: var(--cream-muted);
  }

  .arcade-rules strong {
    color: var(--cream);
  }

  @media (max-width: 760px) {
    .arcade-game {
      padding-top: 2rem;
    }

    .arcade-game-heading {
      align-items: start;
      flex-direction: column;
    }

    .arcade-game-actions {
      justify-items: start;
    }

    .arcade-game-actions > p {
      text-align: left;
    }

    .arcade-cabinet {
      border-radius: 0.75rem;
    }

    .arcade-game[data-view="wide"] .arcade-cabinet {
      height: 78svh;
      min-height: 30rem;
    }

    .arcade-rules {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
  }

  @media (max-width: 760px) and (pointer: coarse) {
    .arcade-direct-launch {
      display: inline-flex;
    }
  }
</style>

<script>
  const game = document.querySelector<HTMLElement>("[data-arcade-game]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-arcade-view-toggle]");
  const label = document.querySelector<HTMLElement>("[data-arcade-view-label]");
  const root = document.querySelector<HTMLElement>("[data-arcade-root]");
  const gameScriptEl = document.querySelector<HTMLScriptElement>("[data-arcade-script]");
  const directLaunch = document.querySelector<HTMLAnchorElement>("[data-arcade-direct-launch]");
  type AnalyticsWindow = Window & {
    trackSparkEvent?: (eventName: string, parameters?: Record<string, string | number | boolean>) => boolean;
  };
  const analyticsWindow = window as AnalyticsWindow;
  let gameLoadTracked = false;

  function trackGameLoad(): void {
    if (gameLoadTracked || !root || root.childElementCount === 0) return;
    if (!analyticsWindow.trackSparkEvent?.("arcade_game_loaded")) return;
    gameLoadTracked = true;
  }

  gameScriptEl?.addEventListener("load", trackGameLoad);
  document.addEventListener("spark-analytics-ready", trackGameLoad);
  if (root) {
    const mountObserver = new MutationObserver(() => {
      trackGameLoad();
      if (gameLoadTracked) mountObserver.disconnect();
    });
    mountObserver.observe(root, { childList: true });
  }
  trackGameLoad();

  window.addEventListener("message", (event) => {
    if (event.origin !== window.location.origin || !event.data || event.data.source !== "spark-arcade") return;
    const { eventName, parameters } = event.data;
    if (eventName !== "arcade_game_started" && eventName !== "arcade_run_finished") return;
    analyticsWindow.trackSparkEvent?.(eventName, parameters);
  });

  directLaunch?.addEventListener("click", () => {
    analyticsWindow.trackSparkEvent?.("arcade_direct_launch", { placement: "mobile_direct" });
  });

  if (game && toggle && label) {
    toggle.addEventListener("click", () => {
      const isWide = game.dataset.view !== "wide";
      game.dataset.view = isWide ? "wide" : "phone";
      toggle.setAttribute("aria-pressed", String(isWide));
      toggle.setAttribute(
        "aria-label",
        isWide ? "Return the game to phone view" : "Expand the game to wide view",
      );
      label.textContent = isWide ? "Phone view" : "Wide view";
      analyticsWindow.trackSparkEvent?.("arcade_view_changed", { view: isWide ? "wide" : "phone" });
    });
  }
</script>
